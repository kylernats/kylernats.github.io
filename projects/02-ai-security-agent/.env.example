# Point the agent at the local Floci emulator. Never a real AWS endpoint.
AWS_ENDPOINT_URL=http://localhost:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# Safety. Set to 1 only if you deliberately intend to target a non-local endpoint.
ALLOW_NON_LOCAL_ENDPOINT=0

# Remediation runs in dry-run unless this is explicitly 0.
DRY_RUN=1
